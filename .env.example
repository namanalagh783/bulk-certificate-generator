# SQLAlchemy database URL. Default is a local SQLite file under ./data.
DATABASE_URL=sqlite:///./data/certgen.db
# To point a local (non-Docker) uvicorn at the Postgres container started by
# `docker compose up` (ADR-020), uncomment the line below instead (port 5433 is published
# on the host specifically so it doesn't clash with a host Postgres on 5432):
# DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5433/certgen

# Root directory where generated certificate PDFs are stored.
STORAGE_DIR=./data/storage

# Background job dispatcher: "thread" runs a real thread pool, "inline" runs synchronously (tests).
DISPATCHER=thread

# Number of jobs the thread pool dispatcher processes in parallel.
WORKER_CONCURRENCY=2

# Maximum number of recipients accepted in a single job submission.
MAX_RECIPIENTS_PER_JOB=1000

# Whether to resume any pending/processing jobs left over from a previous run at startup.
RECOVER_ON_STARTUP=true

# Root logger level.
LOG_LEVEL=INFO
